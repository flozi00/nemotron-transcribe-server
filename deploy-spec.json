{
  "_comment": "The console's deploy_pool spec for the drop-in parakeet replacement. Served model id and hostname stay parakeet's; the pool is a new blue/green name so the old one keeps serving until the swap.",
  "namespace": "maas-inference",
  "name": "parakeet-primeline-v3",
  "runtime": "vllm",
  "model": "nemotron-3.5-transcribe-30b-a4b-nvfp4",
  "weights_from_s3": true,
  "weights_staging": true,
  "weights_staging_mib": 40960,
  "image": "ghcr.io/flozi00/nemotron-transcribe-server:main",
  "gpus": 1,
  "gpu_selectors": ["RTX-PRO-6000"],
  "replicas": 1,
  "served_as": "primeline/parakeet-primeline",
  "env": {
    "VLLM_PLUGINS": "nemo_speechlm",
    "VLLM_MAX_AUDIO_DECODE_DURATION_S": "3600",
    "VLLM_MAX_AUDIO_CLIP_FILESIZE_MB": "180",
    "VLLM_USE_V2_MODEL_RUNNER": "0",
    "VLLM_DISABLED_KERNELS": "FlashInferFP8ScaledMMLinearKernel"
  },
  "args": {
    "--trust-remote-code": true,
    "--dtype": "bfloat16",
    "--kv-cache-dtype": "fp8",
    "--gpu-memory-utilization": 0.85,
    "--max-model-len": 65536,
    "--max-num-batched-tokens": 4096,
    "--max-num-seqs": 64,
    "--enable-chunked-prefill": true,
    "--no-enable-prefix-caching": true,
    "--use-replayssm": true,
    "--mamba-backend": "flashinfer",
    "--mamba-cache-mode": "none",
    "--mm-processor-cache-gb": 0,
    "--no-async-scheduling": true,
    "--limit-mm-per-prompt": "{\"audio\":{\"count\":1,\"length\":57600000}}",
    "--speculative-config": "{\"method\":\"mtp\",\"num_speculative_tokens\":8}",
    "--reasoning-parser": "nemotron_v3",
    "--trust-request-mm-kwargs": true,
    "--middleware": "nemo.collections.speechlm2.vllm.salm.ctc_serving.ctc_timestamp_middleware"
  }
}
